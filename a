				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					svDrag = true
					local x = math.clamp((input.Position.X - SV.AbsolutePosition.X) / SV.AbsoluteSize.X, 0, 1)
					local y = math.clamp((input.Position.Y - SV.AbsolutePosition.Y) / SV.AbsoluteSize.Y, 0, 1)
					s, v = x, 1 - y
					currentColor = Color3.fromHSV(h, s, v)
					update(true)
				end
			end)

			Hue.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					hDrag = true
					local y = math.clamp((input.Position.Y - Hue.AbsolutePosition.Y) / Hue.AbsoluteSize.Y, 0, 1)
					h = 1 - y
					currentColor = Color3.fromHSV(h, s, v)
					update(true)
				end
			end)

			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					svDrag = false
					hDrag = false
				end
			end)

			UserInputService.InputChanged:Connect(function(input)
				if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					if svDrag then
						local x = math.clamp((input.Position.X - SV.AbsolutePosition.X) / SV.AbsoluteSize.X, 0, 1)
						local y = math.clamp((input.Position.Y - SV.AbsolutePosition.Y) / SV.AbsoluteSize.Y, 0, 1)
						s, v = x, 1 - y
						currentColor = Color3.fromHSV(h, s, v)
						update(true)
					elseif hDrag then
						local y = math.clamp((input.Position.Y - Hue.AbsolutePosition.Y) / Hue.AbsoluteSize.Y, 0, 1)
						h = 1 - y
						currentColor = Color3.fromHSV(h, s, v)
						update(true)
					end
				end
			end)

			Preview.MouseButton1Click:Connect(function()
				playSound()
				pickerOpen = not pickerOpen
				Drawer.Visible = pickerOpen
				tween(Card, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					Size = pickerOpen and UDim2.new(1, 0, 0, 196) or UDim2.new(1, 0, 0, 40)
				})
			end)

			update(false)
		end

		return TabObj
	end

	WindowObj.Notify = function(self, opts)
		return createNotify(opts)
	end

	setUIShowing(true)
	return WindowObj
end

return AstralisLib
