			local BtnLayout = Instance.new("UIListLayout")
			BtnLayout.FillDirection = Enum.FillDirection.Horizontal
			BtnLayout.SortOrder = Enum.SortOrder.LayoutOrder
			BtnLayout.Padding = UDim.new(0, 6)
			BtnLayout.Parent = BtnRow

			for i, btnData in ipairs(buttons) do
				local Btn = Instance.new("TextButton")
				Btn.Size = UDim2.new(1 / #buttons, -6 * (#buttons - 1) / #buttons, 1, 0)
				Btn.BackgroundColor3 = Theme.ButtonBackground
				Btn.BorderSizePixel = 0
				Btn.Text = btnData.Text or ("Button " .. i)
				Btn.Font = Theme.Font
				Btn.TextSize = 12
				Btn.TextColor3 = Theme.ButtonTextColor
				Btn.TextXAlignment = Enum.TextXAlignment.Center
				Btn.TextYAlignment = Enum.TextYAlignment.Center
				Btn.AutoButtonColor = false
				Btn.LayoutOrder = i
				Btn.ZIndex = 7
				Btn.Parent = BtnRow
				addCorner(Btn, 6)
				noSelect(Btn)

				local origBg = Btn.BackgroundColor3

				Btn.MouseEnter:Connect(function()
					TweenService:Create(Btn, TweenInfo.new(0.12), {
						BackgroundColor3 = Color3.new(
							math.min(origBg.R + 0.08, 1),
							math.min(origBg.G + 0.08, 1),
							math.min(origBg.B + 0.08, 1)
						)
					}):Play()
				end)

				Btn.MouseLeave:Connect(function()
					TweenService:Create(Btn, TweenInfo.new(0.12), {BackgroundColor3 = origBg}):Play()
				end)

				Btn.MouseButton1Click:Connect(function()
					playSound()
					if btnData.Callback then btnData.Callback() end
					if btnData.CloseOnClick ~= false then
						if activeNotifs[Notif] then activeNotifs[Notif]() end
					end
				end)
			end
		end

		local closeFn
		local cancelled = false

		closeFn = function()
			if cancelled then return end
			cancelled = true
			local tween = TweenService:Create(Notif, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = UDim2.new(0, notifWidth, 0, 0),
				BackgroundTransparency = 1
			})
			tween:Play()
			TweenService:Create(notifStroke, TweenInfo.new(0.25), {Transparency = 1}):Play()
			tween.Completed:Connect(function()
				Notif:Destroy()
				activeNotifs[Notif] = nil
			end)
		end

		activeNotifs[Notif] = closeFn

		CloseIcon.MouseButton1Click:Connect(function()
			playSound()
			closeFn()
		end)

		TweenService:Create(Notif, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, notifWidth, 0, notifHeight)
		}):Play()

		if duration > 0 then
			task.delay(duration, function() closeFn() end)
		end

		return { Close = closeFn, Frame = Notif }
	end

