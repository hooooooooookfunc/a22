		function Tab:CreateSlider(options)
			options = options or {}

			local name = options.Name or "Slider"
			local minimum = options.Min or 0
			local maximum = options.Max or 100
			local callback = options.Callback or function() end
			local decimals = options.Decimals or 0

			if maximum <= minimum then
				maximum = minimum + 1
			end

			local value = math.clamp(
				options.Default or minimum,
				minimum,
				maximum
			)

			local Card = makeCard(65, name)

			makeTitle(Card, name, "", 120)

			local ValueLabel = create("TextLabel", {
				Size = UDim2.fromOffset(80, 20),
				Position = UDim2.new(1, -96, 0, 13),
				BackgroundTransparency = 1,
				Font = Theme.TitleFont,
				TextSize = 12,
				TextColor3 = Theme.AccentColor,
				TextXAlignment = Enum.TextXAlignment.Right,
				ZIndex = 5,
				Parent = Card
			})

			local Track = create("Frame", {
				Size = UDim2.new(1, -36, 0, 5),
				Position = UDim2.new(0, 18, 1, -18),
				BackgroundColor3 = Theme.SliderBackground,
				BorderSizePixel = 0,
				ZIndex = 5,
				Parent = Card
			})

			corner(Track, 4)

			local Fill = create("Frame", {
				Size = UDim2.new(0, 0, 1, 0),
				BackgroundColor3 = Theme.SliderFillColor,
				BorderSizePixel = 0,
				ZIndex = 6,
				Parent = Track
			})

			corner(Fill, 4)

			local Handle = create("Frame", {
				Size = UDim2.fromOffset(13, 13),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0, 0.5),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				ZIndex = 7,
				Parent = Track
			})

			corner(Handle, 7)
			stroke(Handle, Theme.AccentColor, 2)

			local Hitbox = create("TextButton", {
				Size = UDim2.new(1, 20, 0, 24),
				Position = UDim2.fromScale(0.5, 0.5),
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				ZIndex = 10,
				Parent = Track
			})

			clearSelection(Hitbox)

			local sliding = false

			local function formatValue(number)
				return string.format("%." .. decimals .. "f", number)
			end

			local function setValue(number, fire)
				local multiplier = 10 ^ decimals

				value = math.clamp(
					math.floor(number * multiplier + 0.5) / multiplier,
					minimum,
					maximum
				)

				local percentage =
					(value - minimum) / (maximum - minimum)

				Fill.Size = UDim2.new(percentage, 0, 1, 0)
				Handle.Position = UDim2.new(percentage, 0, 0.5, 0)
				ValueLabel.Text = formatValue(value)

				if fire then
					callback(value)
				end
			end

			local function update(input)
				local width = Track.AbsoluteSize.X

				if width <= 0 then return end

				local percentage = math.clamp(
					(input.Position.X - Track.AbsolutePosition.X) / width,
					0,
					1
				)

				setValue(
					minimum + (maximum - minimum) * percentage,
					true
				)
			end

			connect(Hitbox.InputBegan, function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then

					sliding = true
					update(input)
				end
			end)

			connect(UserInputService.InputChanged, function(input)
				if sliding and (
					input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch
				) then
					update(input)
				end
			end)

			connect(UserInputService.InputEnded, function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then

					sliding = false
				end
			end)

			setValue(value, false)

			return {
				Set = function(_, number)
					setValue(tonumber(number) or minimum, true)
				end,

				Get = function()
					return value
				end
			}
		end

