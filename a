			Holder.BackgroundColor3 = Theme.SidebarColor
			Holder.BorderSizePixel = 0
			Holder.ZIndex = 3
			Holder.Parent = Page

			addCorner(Holder, 8)
			addStroke(Holder, Theme.OutlineColor, 1)

			local TitleLbl = Instance.new("TextLabel")
			TitleLbl.Size = UDim2.new(1, -180, 1, 0)
			TitleLbl.Position = UDim2.new(0, 14, 0, 0)
			TitleLbl.BackgroundTransparency = 1
			TitleLbl.Text = name
			TitleLbl.Font = Theme.Font
			TitleLbl.TextSize = 13.5
			TitleLbl.TextColor3 = Theme.TextColor
			TitleLbl.TextXAlignment = Enum.TextXAlignment.Left
			TitleLbl.TextYAlignment = Enum.TextYAlignment.Center
			TitleLbl.ZIndex = 4
			TitleLbl.Parent = Holder

			local Btn = Instance.new("TextButton")
			Btn.Size = UDim2.new(0, 150, 0, 28)
			Btn.AnchorPoint = Vector2.new(1, 0.5)
			Btn.Position = UDim2.new(1, -14, 0.5, 0)
			Btn.BackgroundColor3 = Theme.ButtonBackground
			Btn.BorderSizePixel = 0
			Btn.Font = Theme.Font
			Btn.TextSize = 12
			Btn.TextColor3 = Theme.ButtonTextColor
			Btn.AutoButtonColor = false
			Btn.ZIndex = 4
			Btn.Parent = Holder

			addCorner(Btn, 6)
			local CycleStroke = addStroke(Btn, Theme.OutlineColor, 1)
			noSelect(Btn)

			local currentIndex = 1
			local opts = type(list) == "function" and list() or list

			for i, v in ipairs(opts) do
				if tostring(v) == tostring(default) then
					currentIndex = i
					break
				end
			end

			Btn.Text = tostring(opts[currentIndex] or "Default")

			Btn.MouseEnter:Connect(function()
				TweenService:Create(Btn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(40, 40, 46)}):Play()
				TweenService:Create(CycleStroke, TweenInfo.new(0.12), {Color = Theme.AccentColor}):Play()
			end)
			Btn.MouseLeave:Connect(function()
				TweenService:Create(Btn, TweenInfo.new(0.12), {BackgroundColor3 = Theme.ButtonBackground}):Play()
				TweenService:Create(CycleStroke, TweenInfo.new(0.12), {Color = Theme.OutlineColor}):Play()
			end)

			Btn.MouseButton1Click:Connect(function()
				playSound()
				if type(list) == "function" then opts = list() end
				if #opts == 0 then return end
				currentIndex = currentIndex + 1
				if currentIndex > #opts then currentIndex = 1 end
				local val = opts[currentIndex]
				Btn.Text = tostring(val)
				callback(val)
			end)
		end

