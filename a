local function resolveIcon(id)
	if not id then return DEFAULT_ICONS.default end
	if typeof(id) == "string" and id:find("rbxassetid://") then return id end
	if typeof(id) == "number" then return "rbxassetid://" .. id end
	return DEFAULT_ICONS[string.lower(tostring(id))] or DEFAULT_ICONS.default
end

