				Hit.BackgroundTransparency = 1
				Hit.Text = ""
				Hit.AutoButtonColor = false
				Hit.Parent = Track
				noSelect(Hit)

				local sliding = false

				local function setVal(x, animate)
					x = math.clamp(x, 0, 1)
					local raw = min + (max - min) * x
					if step then raw = math.floor(raw / step + 0.5) * step end
					raw = tonumber(string.format("%.4f", raw))
					local newPct = (raw - min) / (max - min)
					V.Text = tostring(raw) .. suffix
					if animate then
						TweenService:Create(Fill, TweenInfo.new(0.15), { Size = UDim2.new(newPct, 0, 1, 0) }):Play()
						TweenService:Create(Knob, TweenInfo.new(0.15), { Position = UDim2.new(newPct, 0, 0.5, 0) }):Play()
					else
						Fill.Size = UDim2.new(newPct, 0, 1, 0)
						Knob.Position = UDim2.new(newPct, 0, 0.5, 0)
					end
					callback(raw)
				end

				Hit.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						sliding = true
						local x = (input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X
						setVal(x, true)
					end
				end)
				UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						sliding = false
					end
				end)
				UserInputService.InputChanged:Connect(function(input)
					if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
						local x = (input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X
						setVal(x, false)
					end
				end)
			end

