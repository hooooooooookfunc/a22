				Card,
				155,
				tostring(values[currentIndex] or "Default")
			)

			local function select(value, fire)
				values = getOptions()

				for i, item in ipairs(values) do
					if tostring(item) == tostring(value) then
						currentIndex = i
						break
					end
				end

				local selected = values[currentIndex]

				Button.Text = tostring(selected or "Default")

				if fire and selected ~= nil then
					callback(selected)
				end
			end

			connect(Button.MouseButton1Click, function()
				playSound()

				values = getOptions()

				if #values == 0 then
					Button.Text = "Empty"
					return
				end

				currentIndex = currentIndex % #values + 1

				select(values[currentIndex], true)
			end)

			return {
				Set = function(_, value)
					select(value, true)
				end,

				Get = function()
					values = getOptions()
					return values[currentIndex]
				end,

				Refresh = function()
					values = getOptions()
					currentIndex = math.clamp(currentIndex, 1, math.max(#values, 1))
					Button.Text = tostring(values[currentIndex] or "Empty")
				end
			}
		end

		-- TEXTBOX

		function Tab:CreateTextBox(options)
			options = options or {}

			local name = options.Name or "TextBox"
			local callback = options.Callback or function() end

			local Card = makeCard(50, name)
			makeTitle(Card, name, "", 195)

			local Box = create("TextBox", {
				Size = UDim2.fromOffset(155, 30),
				Position = UDim2.new(1, -16, 0.5, 0),
				AnchorPoint = Vector2.new(1, 0.5),
				BackgroundColor3 = Theme.ButtonBackground,
				BorderSizePixel = 0,
				Text = tostring(options.Default or ""),
				PlaceholderText = options.Placeholder or "Enter text...",
				PlaceholderColor3 = Theme.DescriptionColor,
				Font = Theme.Font,
				TextSize = 12,
				TextColor3 = Theme.TextColor,
				ClearTextOnFocus = false,
				ZIndex = 6,
				Parent = Card
			})

			corner(Box, 7)

			local Border = stroke(Box, Theme.OutlineColor)

			connect(Box.Focused, function()
				tween(Border, {
					Color = Theme.AccentColor
				}, 0.15)
			end)

			connect(Box.FocusLost, function()
				tween(Border, {
					Color = Theme.OutlineColor
				}, 0.15)

				playSound()
				callback(Box.Text)
			end)

			return {
				Set = function(_, value)
					Box.Text = tostring(value)
				end,

				Get = function()
					return Box.Text
				end
			}
		end

		-- COLOR PICKER

		function Tab:CreateColorPicker(options)
			options = options or {}

			local name = options.Name or "Color Picker"
			local description = options.Description or ""
			local callback = options.Callback or function() end

			local currentColor = options.Default or Theme.AccentColor
			local hue, saturation, brightness = Color3.toHSV(currentColor)
			local opened = false

			local Card = makeCard(50, name)
			Card.ClipsDescendants = true

			makeTitle(Card, name, description, 90)

			local Preview = create("TextButton", {
				Size = UDim2.fromOffset(42, 26),
				Position = UDim2.new(1, -16, 0, 12),
				AnchorPoint = Vector2.new(1, 0),
				BackgroundColor3 = currentColor,
				BorderSizePixel = 0,
				Text = "",
				AutoButtonColor = false,
				ZIndex = 6,
				Parent = Card
			})

			corner(Preview, 7)
			stroke(Preview, Theme.OutlineColor)
			addButtonAnimation(Preview)

			local PickerArea = create("Frame", {
				Size = UDim2.new(1, -32, 0, 195),
				Position = UDim2.fromOffset(16, 56),
				BackgroundTransparency = 1,
				Visible = false,
				ZIndex = 5,
				Parent = Card
			})

			-- SATURATION / VALUE

			local SV = create("Frame", {
				Size = UDim2.new(1, -105, 0, 165),
				BackgroundColor3 = Color3.fromHSV(hue, 1, 1),
				BorderSizePixel = 0,
				Active = true,
				ZIndex = 6,
				Parent = PickerArea
			})

			corner(SV, 7)

			local White = create("Frame", {
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				ZIndex = 7,
				Parent = SV
			})

			corner(White, 7)

			create("UIGradient", {
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0),
					NumberSequenceKeypoint.new(1, 1)
				}),
				Parent = White
			})

			local Black = create("Frame", {
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = Color3.new(0, 0, 0),
				BorderSizePixel = 0,
				ZIndex = 8,
				Parent = SV
			})

			corner(Black, 7)

			create("UIGradient", {
				Rotation = 90,
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(1, 0)
				}),
				Parent = Black
			})

			local SVMarker = create("Frame", {
				Size = UDim2.fromOffset(12, 12),
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				ZIndex = 10,
				Parent = SV
			})

			corner(SVMarker, 7)
			stroke(SVMarker, Color3.new(0, 0, 0), 1.5)

			-- HUE

			local Hue = create("Frame", {
				Size = UDim2.fromOffset(14, 165),
				Position = UDim2.new(1, -88, 0, 0),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				Active = true,
				ZIndex = 6,
				Parent = PickerArea
			})

			corner(Hue, 5)

			create("UIGradient", {
				Rotation = 90,
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
					ColorSequenceKeypoint.new(0.167, Color3.fromRGB(255, 255, 0)),
					ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)),
					ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
					ColorSequenceKeypoint.new(0.667, Color3.fromRGB(0, 0, 255)),
					ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0))
				}),
				Parent = Hue
			})

			local HueMarker = create("Frame", {
				Size = UDim2.new(1, 6, 0, 5),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, 0, 0, 0),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				ZIndex = 9,
				Parent = Hue
			})

			corner(HueMarker, 3)
			stroke(HueMarker, Color3.new(0, 0, 0))

			-- HEX INPUT

			local HexLabel = create("TextLabel", {
				Size = UDim2.fromOffset(70, 20),
				Position = UDim2.new(1, -65, 0, 0),
				BackgroundTransparency = 1,
				Text = "HEX",
				Font = Theme.TitleFont,
				TextSize = 10,
				TextColor3 = Theme.DescriptionColor,
				Parent = PickerArea
			})

			local HexBox = create("TextBox", {
				Size = UDim2.fromOffset(65, 30),
				Position = UDim2.new(1, -65, 0, 25),
				BackgroundColor3 = Theme.ButtonBackground,
				BorderSizePixel = 0,
				Text = currentColor:ToHex(),
				Font = Theme.Font,
				TextSize = 11,
				TextColor3 = Theme.TextColor,
				ClearTextOnFocus = false,
				Parent = PickerArea
			})

			corner(HexBox, 6)
			local HexStroke = stroke(HexBox, Theme.OutlineColor)

			local ColorPreview = create("Frame", {
				Size = UDim2.fromOffset(65, 45),
				Position = UDim2.new(1, -65, 0, 70),
				BackgroundColor3 = currentColor,
				BorderSizePixel = 0,
				Parent = PickerArea
			})

			corner(ColorPreview, 7)
			stroke(ColorPreview, Theme.OutlineColor)

			local function updateVisuals()
				currentColor = Color3.fromHSV(
					hue,
					saturation,
					brightness
				)

				Preview.BackgroundColor3 = currentColor
				ColorPreview.BackgroundColor3 = currentColor
				SV.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)

				SVMarker.Position = UDim2.new(
					saturation,
					0,
					1 - brightness,
					0
				)

				HueMarker.Position = UDim2.new(
					0.5,
					0,
					hue,
					0
				)

				HexBox.Text = currentColor:ToHex()
			end

			local function setColor(color, fire)
				if typeof(color) ~= "Color3" then return end

				currentColor = color
				hue, saturation, brightness = Color3.toHSV(color)

				updateVisuals()

				if fire then
					callback(currentColor)
				end
			end

			local function updateSV(input)
				if SV.AbsoluteSize.X <= 0 or SV.AbsoluteSize.Y <= 0 then
					return
				end

				saturation = math.clamp(
					(input.Position.X - SV.AbsolutePosition.X)
						/ SV.AbsoluteSize.X,
					0,
					1
				)

				brightness = 1 - math.clamp(
					(input.Position.Y - SV.AbsolutePosition.Y)
						/ SV.AbsoluteSize.Y,
					0,
					1
				)

				updateVisuals()
				callback(currentColor)
			end

			local function updateHue(input)
				if Hue.AbsoluteSize.Y <= 0 then return end

				hue = math.clamp(
					(input.Position.Y - Hue.AbsolutePosition.Y)
						/ Hue.AbsoluteSize.Y,
					0,
					1
				)

				updateVisuals()
				callback(currentColor)
			end

			local draggingSV = false
			local draggingHue = false

			connect(SV.InputBegan, function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then

					draggingSV = true
					updateSV(input)
				end
			end)

			connect(Hue.InputBegan, function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then

					draggingHue = true
					updateHue(input)
				end
			end)

			connect(UserInputService.InputChanged, function(input)
				if input.UserInputType ~= Enum.UserInputType.MouseMovement
					and input.UserInputType ~= Enum.UserInputType.Touch then
					return
				end

				if draggingSV then
					updateSV(input)
				elseif draggingHue then
					updateHue(input)
				end
			end)

			connect(UserInputService.InputEnded, function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then

					draggingSV = false
					draggingHue = false
				end
			end)

			connect(HexBox.Focused, function()
				tween(HexStroke, {
					Color = Theme.AccentColor
				}, 0.15)
			end)

			connect(HexBox.FocusLost, function()
				tween(HexStroke, {
					Color = Theme.OutlineColor
				}, 0.15)

				local hex = HexBox.Text:gsub("#", ""):gsub("%s+", "")

				if #hex == 6 and hex:match("^[%x]+$") then
					local success, color = pcall(function()
						return Color3.fromHex(hex)
					end)

					if success then
						setColor(color, true)
						return
					end
				end

				updateVisuals()
			end)

			local function setOpen(state)
				opened = state == true

				if opened then
					PickerArea.Visible = true
				end

				local animation = tween(Card, {
					Size = UDim2.new(
						1,
						0,
						0,
						opened and 265 or 50
					)
				}, 0.3)

				if not opened then
					animation.Completed:Once(function()
						if not opened then
							PickerArea.Visible = false
						end
					end)
				end
			end

			connect(Preview.MouseButton1Click, function()
				playSound()
				setOpen(not opened)
			end)

			updateVisuals()

			return {
				Set = function(_, color)
					setColor(color, true)
				end,

				Get = function()
					return currentColor
				end,

				Open = function()
					setOpen(true)
				end,

				Close = function()
					setOpen(false)
				end
			}
		end

		return Tab
	end

	return Window
end

return AstralisLib
