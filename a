local function getIcon(nameOrId)
	nameOrId = tostring(nameOrId or "")
	if string.find(nameOrId, "rbxassetid://") then
		return nameOrId
	end
	if tonumber(nameOrId) then
		return "rbxassetid://" .. nameOrId
	end
	return ICONS[string.lower(nameOrId)] or ICONS.info
end

