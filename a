	local NL = Instance.new("UIListLayout")
	NL.FillDirection = Enum.FillDirection.Vertical
	NL.VerticalAlignment = Enum.VerticalAlignment.Bottom
	NL.HorizontalAlignment = Enum.HorizontalAlignment.Right
	NL.SortOrder = Enum.SortOrder.LayoutOrder
	NL.Padding = UDim.new(0, 8)
	NL.Parent = NotifyHolder

	local function notify(opts)
		opts = opts or {}
		local title = opts.Title or "Notification"
		local text = opts.Text or ""
		local dur = opts.Duration or 4

		local Row = Instance.new("Frame")
		Row.Size = UDim2.new(0, 240, 0, 0)
		Row.BackgroundTransparency = 1
		Row.ClipsDescendants = true
		Row.Parent = NotifyHolder

		local Box = Instance.new("Frame")
		Box.Size = UDim2.new(1, 0, 1, 0)
		Box.Position = UDim2.new(1, 30, 0, 0)
		Box.BackgroundColor3 = Theme.Background
		Box.BorderSizePixel = 0
		Box.Parent = Row
		corner(Box, 8)
		stroke(Box, Theme.BorderBright, 1)

		local T = Instance.new("TextLabel")
		T.Size = UDim2.new(1, -46, 0, 20)
		T.Position = UDim2.new(0, 14, 0, 10)
		T.BackgroundTransparency = 1
		T.Text = title
		T.Font = Theme.Font
		T.TextSize = 14
		T.TextColor3 = Theme.Text
		T.TextXAlignment = Enum.TextXAlignment.Left
		T.Parent = Box

		local B = Instance.new("TextLabel")
		B.Size = UDim2.new(1, -28, 0, 16)
		B.Position = UDim2.new(0, 14, 0, 32)
		B.BackgroundTransparency = 1
		B.Text = text
		B.Font = Theme.Font
		B.TextSize = 12
		B.TextColor3 = Theme.TextMuted
		B.TextXAlignment = Enum.TextXAlignment.Left
		B.Parent = Box

		local X = Instance.new("TextButton")
		X.Size = UDim2.new(0, 20, 0, 20)
		X.Position = UDim2.new(1, -26, 0, 8)
		X.BackgroundTransparency = 1
		X.Text = "X"
		X.Font = Enum.Font.Arcade
		X.TextSize = 10
		X.TextColor3 = Theme.TextMuted
		X.AutoButtonColor = false
		X.Parent = Box
		noSelect(X)

		X.MouseEnter:Connect(function()
			TweenService:Create(X, TweenInfo.new(0.12), { TextColor3 = Color3.fromRGB(240, 70, 70) }):Play()
		end)
		X.MouseLeave:Connect(function()
			TweenService:Create(X, TweenInfo.new(0.12), { TextColor3 = Theme.TextMuted }):Play()
		end)

		local close, done
		close = function()
			if done then return end
			done = true
			local t = TweenService:Create(Row, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
