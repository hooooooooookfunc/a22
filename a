		function TabObj:CreateColorPicker(options)
			options = options or {}
			local name = options.Name or "Color Picker"
			local desc = options.Description or ""
			local default = options.Default or Theme.AccentColor
			local callback = options.Callback or function() end
			local currentColor = default
			local pickerOpen = false

			-- Inline frame expansion prevents ScrollingFrame clipping issues
			local Holder = Instance.new("Frame")
			Holder.Size = UDim2.new(1, 0, 0, 44)
			Holder.BackgroundColor3 = Theme.SidebarColor
			Holder.BorderSizePixel = 0
			Holder.ClipsDescendants = true
			Holder.ZIndex = 3
			Holder.Parent = Page

			addCorner(Holder, 8)
			addStroke(Holder, Theme.OutlineColor, 1)

			local TitleLbl = Instance.new("TextLabel")
			TitleLbl.Size = UDim2.new(1, -70, 0, 18)
			TitleLbl.Position = UDim2.new(0, 14, 0, (desc ~= "") and 6 or 13)
			TitleLbl.BackgroundTransparency = 1
			TitleLbl.Text = name
			TitleLbl.Font = Theme.Font
			TitleLbl.TextSize = 13.5
			TitleLbl.TextColor3 = Theme.TextColor
			TitleLbl.TextXAlignment = Enum.TextXAlignment.Left
			TitleLbl.ZIndex = 4
			TitleLbl.Parent = Holder

			if desc ~= "" then
				local DescLbl = Instance.new("TextLabel")
				DescLbl.Size = UDim2.new(1, -70, 0, 14)
				DescLbl.Position = UDim2.new(0, 14, 0, 24)
				DescLbl.BackgroundTransparency = 1
				DescLbl.Text = desc
				DescLbl.Font = Theme.Font
				DescLbl.TextSize = 11
				DescLbl.TextColor3 = Theme.DescriptionColor
				DescLbl.TextXAlignment = Enum.TextXAlignment.Left
				DescLbl.ZIndex = 4
				DescLbl.Parent = Holder
			end

			local Preview = Instance.new("TextButton")
			Preview.Size = UDim2.new(0, 36, 0, 24)
			Preview.AnchorPoint = Vector2.new(1, 0)
			Preview.Position = UDim2.new(1, -14, 0, 10)
			Preview.BackgroundColor3 = currentColor
			Preview.BorderSizePixel = 0
			Preview.Text = ""
			Preview.AutoButtonColor = false
			Preview.ZIndex = 5
			Preview.Parent = Holder

			addCorner(Preview, 5)
			addStroke(Preview, Theme.OutlineColor, 1)
			noSelect(Preview)

			local SelectorArea = Instance.new("Frame")
			SelectorArea.Size = UDim2.new(1, -28, 0, 180)
			SelectorArea.Position = UDim2.new(0, 14, 0, 48)
			SelectorArea.BackgroundTransparency = 1
			SelectorArea.Visible = false
			SelectorArea.ZIndex = 5
			SelectorArea.Parent = Holder

			local SV = Instance.new("Frame")
			SV.Size = UDim2.new(1, -70, 1, 0)
			SV.BackgroundColor3 = Color3.fromHSV(0, 1, 1)
			SV.BorderSizePixel = 0
			SV.ZIndex = 5
			SV.Parent = SelectorArea

			addCorner(SV, 6)
			addStroke(SV, Theme.OutlineColor, 1)

			local SVWhite = Instance.new("Frame")
			SVWhite.Size = UDim2.new(1, 0, 1, 0)
			SVWhite.BackgroundColor3 = Color3.new(1, 1, 1)
			SVWhite.BorderSizePixel = 0
			SVWhite.ZIndex = 6
			SVWhite.Parent = SV

			local WhiteGradient = Instance.new("UIGradient")
			WhiteGradient.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 1)
			})
			WhiteGradient.Parent = SVWhite

			local SVBlack = Instance.new("Frame")
			SVBlack.Size = UDim2.new(1, 0, 1, 0)
			SVBlack.BackgroundColor3 = Color3.new(0, 0, 0)
			SVBlack.BorderSizePixel = 0
			SVBlack.ZIndex = 7
			SVBlack.Parent = SV

			local BlackGradient = Instance.new("UIGradient")
			BlackGradient.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(1, 0)
			})
			BlackGradient.Rotation = 90
			BlackGradient.Parent = SVBlack

			local SVMarker = Instance.new("Frame")
			SVMarker.Size = UDim2.new(0, 10, 0, 10)
			SVMarker.AnchorPoint = Vector2.new(0.5, 0.5)
			SVMarker.BackgroundColor3 = Color3.new(1, 1, 1)
			SVMarker.BorderSizePixel = 0
			SVMarker.ZIndex = 8
			SVMarker.Parent = SV

			addCorner(SVMarker, 5)
			addStroke(SVMarker, Color3.new(0, 0, 0), 1)

			local Hue = Instance.new("Frame")
			Hue.Size = UDim2.new(0, 12, 1, 0)
			Hue.Position = UDim2.new(1, -56, 0, 0)
			Hue.BackgroundColor3 = Color3.new(1, 1, 1)
			Hue.BorderSizePixel = 0
			Hue.ZIndex = 5
			Hue.Parent = SelectorArea

			addCorner(Hue, 4)
			addStroke(Hue, Theme.OutlineColor, 1)

			local HueGradient = Instance.new("UIGradient")
			HueGradient.Rotation = 90
			HueGradient.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
				ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
				ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
				ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
				ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
				ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
				ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0))
			})
			HueGradient.Parent = Hue

			local HueMarker = Instance.new("Frame")
			HueMarker.Size = UDim2.new(1, 4, 0, 6)
			HueMarker.AnchorPoint = Vector2.new(0.5, 0.5)
			HueMarker.BackgroundColor3 = Color3.new(1, 1, 1)
			HueMarker.BorderSizePixel = 0
			HueMarker.ZIndex = 6
			HueMarker.Parent = Hue

			addCorner(HueMarker, 2)
			addStroke(HueMarker, Color3.new(0, 0, 0), 1)

			local HexBox = Instance.new("TextBox")
			HexBox.Size = UDim2.new(0, 34, 1, 0)
			HexBox.Position = UDim2.new(1, -34, 0, 0)
			HexBox.BackgroundColor3 = Theme.ButtonBackground
			HexBox.BorderSizePixel = 0
			HexBox.Text = currentColor:ToHex()
			HexBox.Font = Theme.Font
			HexBox.TextSize = 10
			HexBox.TextColor3 = Theme.TextColor
			HexBox.ZIndex = 5
			HexBox.Parent = SelectorArea

			addCorner(HexBox, 4)
			addStroke(HexBox, Theme.OutlineColor, 1)

			local hue, saturation, value = Color3.toHSV(currentColor)

			local function setColor(color, fireCallback)
				color = color or currentColor
				currentColor = color
				hue, saturation, value = Color3.toHSV(currentColor)
				Preview.BackgroundColor3 = currentColor
				SV.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
				SVMarker.Position = UDim2.new(saturation, 0, 1 - value, 0)
				HueMarker.Position = UDim2.new(0.5, 0, 1 - hue, 0)
				HexBox.Text = currentColor:ToHex()

				if fireCallback then
					callback(currentColor)
				end
			end

			local function updateFromSV(input)
				local x = math.clamp((input.Position.X - SV.AbsolutePosition.X) / SV.AbsoluteSize.X, 0, 1)
				local y = math.clamp((input.Position.Y - SV.AbsolutePosition.Y) / SV.AbsoluteSize.Y, 0, 1)
				saturation = x
				value = 1 - y
				setColor(Color3.fromHSV(hue, saturation, value), true)
			end

			local function updateFromHue(input)
				local y = math.clamp((input.Position.Y - Hue.AbsolutePosition.Y) / Hue.AbsoluteSize.Y, 0, 1)
				hue = 1 - y
				setColor(Color3.fromHSV(hue, saturation, value), true)
			end

			local svDragging = false
			local hueDragging = false

			SV.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					svDragging = true
					updateFromSV(input)
				end
			end)

			Hue.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					hueDragging = true
					updateFromHue(input)
				end
			end)

			UserInputService.InputChanged:Connect(function(input)
				if svDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					updateFromSV(input)
				elseif hueDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					updateFromHue(input)
				end
			end)

			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					svDragging = false
					hueDragging = false
				end
			end)

			HexBox.FocusLost:Connect(function()
				local hex = HexBox.Text:gsub("#", ""):gsub("%s+", "")
				if #hex == 6 and hex:match("^[%x]+$") then
					local r = tonumber(hex:sub(1, 2), 16)
					local g = tonumber(hex:sub(3, 4), 16)
					local b = tonumber(hex:sub(5, 6), 16)
					if r and g and b then
						setColor(Color3.fromRGB(r, g, b), true)
						return
					end
				end
				HexBox.Text = currentColor:ToHex()
			end)

			local function setOpen(state)
				pickerOpen = state
				SelectorArea.Visible = state
				local targetHeight = state and 240 or 44
				TweenService:Create(Holder, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
					Size = UDim2.new(1, 0, 0, targetHeight)
				}):Play()
			end

			Preview.MouseButton1Click:Connect(function()
				playSound()
				setOpen(not pickerOpen)
			end)

			setColor(currentColor, false)

			return {
				Set = function(_, color)
					if typeof(color) == "Color3" then
						setColor(color, true)
					end
				end,
				Get = function()
					return currentColor
				end,
				Open = function()
					setOpen(true)
				end,
				Close = function()
					setOpen(false)
				end
			}
		end

		return TabObj
	end

	WindowObj.Notify = function(self, opts)
		return createNotify(opts)
	end

	setUIShowing(true)
	return WindowObj
end

return AstralisLib
