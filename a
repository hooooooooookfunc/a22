			for idx, p in ipairs(Pages) do
				local active = (idx == tabIndex)
				p.Visible = active
				local tabData = Tabs[idx]
				tween(tabData.Button, TweenInfo.new(0.2), {
					BackgroundTransparency = active and 0.4 or 1
				})
				tween(tabData.Icon, TweenInfo.new(0.2), {
					ImageColor3 = active and Theme.TextPrimary or Theme.TextMuted
				})
				tween(tabData.Pill, TweenInfo.new(0.2), {
					Size = active and UDim2.new(0, 3, 0, 18) or UDim2.new(0, 3, 0, 0)
				})
			end
