	local function hover(btn, normal, hovered)
		btn.MouseEnter:Connect(function()
			TweenService:Create(btn, TweenInfo.new(0.12), { TextColor3 = hovered }):Play()
		end)
		btn.MouseLeave:Connect(function()
			TweenService:Create(btn, TweenInfo.new(0.12), { TextColor3 = normal }):Play()
		end)
	end
	hover(CloseBtn, Color3.fromRGB(150,150,150), Color3.fromRGB(240, 70, 70))
