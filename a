	MainGui.DisplayOrder = 100
	pcall(function() MainGui.Parent = CoreGui end)
	if not MainGui.Parent then MainGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

	local Window = Instance.new("CanvasGroup")
	Window.Size = UDim2.new(0, BASE_W, 0, BASE_H)
	Window.Position = UDim2.new(0.5, 0, 0.5, 0)
	Window.AnchorPoint = Vector2.new(0.5, 0.5)
	Window.BackgroundColor3 = Theme.WindowBg
	Window.BackgroundTransparency = 0
	Window.BorderSizePixel = 0
	Window.GroupTransparency = 1
	Window.Parent = MainGui
	corner(Window, Theme.WindowRadius)
	stroke(Window, Theme.Border, 1)

	local UIScale = Instance.new("UIScale")
	UIScale.Parent = Window
	UIScale.Scale = 0.9

	local baseScale = 1
	local function updateScale()
		local vp = MainGui.AbsoluteSize
		if vp.X <= 0 or vp.Y <= 0 then return end
		local s = math.min(vp.X * 0.95 / BASE_W, vp.Y * 0.92 / BASE_H, 1)
		baseScale = math.clamp(s, 0.5, 1)
	end
	MainGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		updateScale()
		local prev = UIScale.Scale
		UIScale.Scale = baseScale
		-- Softly re-tween on resize
		UIScale.Scale = prev
		TweenService:Create(UIScale, TweenInfo.new(0.2), { Scale = baseScale }):Play()
	end)
	task.spawn(updateScale)

