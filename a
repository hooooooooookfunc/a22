		TxtDesc.Parent = Card

		local function close()
			local t = tween(Card, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1})
			t.Completed:Connect(function()
				Card:Destroy()
				activeNotifs[Card] = nil
			end)
		end

		activeNotifs[Card] = close
		tween(Card, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, cardHeight)})

		if duration > 0 then
			task.delay(duration, close)
		end
