		InputBg       = cfg.InputColor or Color3.fromRGB(26, 26, 30),
		RowHover      = cfg.RowHover or Color3.fromRGB(36, 36, 40),

		Accent     = cfg.AccentColor or Color3.fromRGB(40, 175, 75),
		AccentSoft = cfg.AccentSoft or Color3.fromRGB(32, 120, 55),

		Text      = cfg.TextColor or Color3.fromRGB(225, 225, 230),
		TextMuted = cfg.DescriptionColor or Color3.fromRGB(130, 130, 140),
		TextDim   = cfg.TextDim or Color3.fromRGB(85, 85, 95),

		Border      = cfg.StrokeColor or Color3.fromRGB(40, 40, 44),
		BorderBright= cfg.OutlineColor or Color3.fromRGB(60, 60, 66),

		TabSelected = cfg.TabSelectedColor or Color3.fromRGB(38, 38, 42),
		TabText     = cfg.TabTextColor or Color3.fromRGB(150, 150, 160),
		TabActive   = cfg.TabActiveTextColor or Color3.fromRGB(255, 255, 255),

		ToggleOff   = cfg.ToggleOffColor or Color3.fromRGB(45, 45, 52),
		ToggleKnob  = cfg.ToggleKnobColor or Color3.fromRGB(240, 240, 245),

		SliderBg    = cfg.SliderBackground or Color3.fromRGB(28, 28, 32),
		SliderFill  = cfg.SliderFillColor or Color3.fromRGB(55, 55, 60),

		WindowRadius = cfg.CornerRadius or 10,
		CardRadius   = cfg.CardRadius or 8,
	}

	local BASE_W, BASE_H = 900, 540

	local function play()
		if not Theme.SoundEnabled then return end
		clickSound.TimePosition = 0
		clickSound:Play()
	end

	-- ==========================================================
	-- Root
	-- ==========================================================
	local MainGui = Instance.new("ScreenGui")
	MainGui.Name = "AstralisLib"
	MainGui.ResetOnSpawn = false
	MainGui.IgnoreGuiInset = true
	MainGui.DisplayOrder = 100
	pcall(function() MainGui.Parent = CoreGui end)
	if not MainGui.Parent then MainGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

	local Window = Instance.new("CanvasGroup")
	Window.Size = UDim2.new(0, BASE_W, 0, BASE_H)
	Window.Position = UDim2.new(0.5, 0, 0.5, 0)
	Window.AnchorPoint = Vector2.new(0.5, 0.5)
	Window.BackgroundColor3 = Theme.Background
	Window.BorderSizePixel = 0
	Window.GroupTransparency = 1
	Window.Parent = MainGui
	corner(Window, Theme.WindowRadius)
	stroke(Window, Theme.BorderBright, 1.2)

	local UIScale = Instance.new("UIScale")
	UIScale.Parent = Window
	UIScale.Scale = 0.9

	local baseScale = 1
	local function computeScale()
		local vp = MainGui.AbsoluteSize
		if vp.X <= 0 or vp.Y <= 0 then return baseScale end
		local s = math.min(vp.X * 0.94 / BASE_W, vp.Y * 0.9 / BASE_H, 1)
		return math.clamp(s, 0.45, 1)
	end

	local function updateScale(animate)
		baseScale = computeScale()
		if animate then
			TweenService:Create(UIScale, TweenInfo.new(0.22, Enum.EasingStyle.Quad), {
				Scale = baseScale
			}):Play()
		else
			UIScale.Scale = baseScale
		end
	end

	MainGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() updateScale(false) end)
	task.spawn(updateScale)

