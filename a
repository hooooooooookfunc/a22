			TweenService:Create(CloseIcon, TweenInfo.new(0.12), {TextColor3 = Color3.fromRGB(240, 70, 70)}):Play()
		end)
		CloseIcon.MouseLeave:Connect(function()
			TweenService:Create(CloseIcon, TweenInfo.new(0.12), {TextColor3 = Theme.DescriptionColor}):Play()
