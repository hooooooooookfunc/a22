			Content.AutomaticSize = Enum.AutomaticSize.Y
			Content.Position = UDim2.new(0, 0, 0, HeaderHeight + 1)
			Content.BackgroundTransparency = 1
			Content.ZIndex = 4
			Content.Parent = Card

			local ContentLayout = Instance.new("UIListLayout")
			ContentLayout.SortOrder = Enum.SortOrder.LayoutOrder
			ContentLayout.Padding = UDim.new(0, 8)
			ContentLayout.Parent = Content

			local ContentPadding = Instance.new("UIPadding")
			ContentPadding.PaddingTop = UDim.new(0, 10)
			ContentPadding.PaddingBottom = UDim.new(0, 10)
			ContentPadding.PaddingLeft = UDim.new(0, 12)
			ContentPadding.PaddingRight = UDim.new(0, 12)
			ContentPadding.Parent = Content

			local function syncSize()
				Card.Size = UDim2.new(1, 0, 0, HeaderHeight + 1 + Content.AbsoluteSize.Y)
			end

			Content:GetPropertyChangedSignal("AbsoluteSize"):Connect(syncSize)
			task.defer(syncSize)

			local GroupObj = {}

			local function makeHolder(height)
				local h = Instance.new("Frame")
				h.Size = UDim2.new(1, 0, 0, height)
				h.BackgroundTransparency = 1
				h.ZIndex = 4
				h.Parent = Content
				return h
			end

			function GroupObj:CreateToggle(o) return buildToggle(o, makeHolder) end
			function GroupObj:CreateSlider(o) return buildSlider(o, makeHolder) end
			function GroupObj:CreateButton(o) return buildButton(o, makeHolder) end
			function GroupObj:CreateColorPicker(o) return buildColorPicker(o, makeHolder) end

			function GroupObj:CreateLabel(o)
				o = o or {}
				local Holder = makeHolder(20)
				local Lbl = Instance.new("TextLabel")
				Lbl.Size = UDim2.new(1, 0, 1, 0)
				Lbl.BackgroundTransparency = 1
				Lbl.Text = o.Text or "Label"
				Lbl.Font = Theme.Font
				Lbl.TextSize = 12
				Lbl.TextColor3 = o.Color or Theme.DescriptionColor
				Lbl.TextXAlignment = Enum.TextXAlignment.Left
				Lbl.TextYAlignment = Enum.TextYAlignment.Center
				Lbl.ZIndex = 5
				Lbl.Parent = Holder
			end

			return GroupObj
		end

		return TabObj
	end

