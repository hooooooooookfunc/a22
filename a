		return { Close = close }
	end

	-- ==========================================================
	-- Tab switching
	-- ==========================================================
	local TabList = {}
	local ActiveIdx = 1

	local function switchTab(idx)
		if ActiveIdx == idx and TabList[idx] and TabList[idx].Tab.Frame.Visible then return end
		ActiveIdx = idx

		for i, e in ipairs(TabList) do
			local active = (i == idx)
			local nav, tab = e.Nav, e.Tab

			if active then
				tab.Frame.Visible = true
				tab.Frame.GroupTransparency = 1
				TweenService:Create(tab.Frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
					GroupTransparency = 0
				}):Play()
				CurrentTab = tab
			elseif tab.Frame.Visible then
				local t = TweenService:Create(tab.Frame, TweenInfo.new(0.14, Enum.EasingStyle.Quad), {
					GroupTransparency = 1
				})
				t:Play()
				t.Completed:Connect(function()
					if ActiveIdx ~= i then tab.Frame.Visible = false end
				end)
			end

			TweenService:Create(nav.Bg, TweenInfo.new(0.14), {
				BackgroundTransparency = active and 0 or 1
			}):Play()
			TweenService:Create(nav.Icon, TweenInfo.new(0.14), {
				ImageColor3 = active and Theme.TabActive or Theme.TabText
			}):Play()
			TweenService:Create(nav.Label, TweenInfo.new(0.14), {
				TextColor3 = active and Theme.TabActive or Theme.TabText
			}):Play()
		end
	end

