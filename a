				Position = UDim2.new(1, 30, 0, 0),
				BackgroundTransparency = 1
			}):Play()
			t:Play()
			t.Completed:Connect(function() Row:Destroy() end)
		end
		X.MouseButton1Click:Connect(function() play(); close() end)

		TweenService:Create(Row, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, 240, 0, 66)
		}):Play()
