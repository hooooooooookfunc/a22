				Chev.Text = "▾"
				Chev.Font = Enum.Font.Gotham
				Chev.TextSize = 12
				Chev.TextColor3 = Theme.TextMuted
				Chev.Parent = Btn

				Btn.MouseEnter:Connect(function()
					TweenService:Create(Btn, TweenInfo.new(0.12), { BackgroundColor3 = Theme.RowHover }):Play()
				end)
				Btn.MouseLeave:Connect(function()
					TweenService:Create(Btn, TweenInfo.new(0.12), { BackgroundColor3 = Theme.InputBg }):Play()
				end)

				local Popup = Instance.new("Frame")
				Popup.Visible = false
				Popup.BackgroundColor3 = Theme.CardBg
				Popup.BorderSizePixel = 0
				Popup.ZIndex = 500
				Popup.Parent = Window
				corner(Popup, 6)
				stroke(Popup, Theme.Border, 1)

				local PList = Instance.new("ScrollingFrame")
				PList.Size = UDim2.new(1, 0, 1, 0)
				PList.BackgroundTransparency = 1
				PList.BorderSizePixel = 0
				PList.ScrollBarThickness = 3
				PList.ScrollBarImageColor3 = Theme.Border
				PList.CanvasSize = UDim2.new(0, 0, 0, math.min(#items, 6) * 28)
				PList.Parent = Popup

				local PL = Instance.new("UIListLayout")
				PL.SortOrder = Enum.SortOrder.LayoutOrder
				PL.Parent = PList

				local PP = Instance.new("UIPadding")
				PP.PaddingTop = UDim.new(0, 4)
				PP.PaddingBottom = UDim.new(0, 4)
				PP.Parent = PList

				for i, item in ipairs(items) do
					local itemBtn = Instance.new("TextButton")
					itemBtn.Size = UDim2.new(1, 0, 0, 26)
					itemBtn.BackgroundColor3 = Theme.RowHover
					itemBtn.BackgroundTransparency = 1
					itemBtn.Text = ""
					itemBtn.AutoButtonColor = false
					itemBtn.LayoutOrder = i
					itemBtn.Parent = PList
					corner(itemBtn, 4)
					noSelect(itemBtn)

					local itemTxt = Instance.new("TextLabel")
					itemTxt.Size = UDim2.new(1, -16, 1, 0)
					itemTxt.Position = UDim2.new(0, 10, 0, 0)
					itemTxt.BackgroundTransparency = 1
					itemTxt.Text = tostring(item)
					itemTxt.Font = Theme.Font
					itemTxt.TextSize = 12
					itemTxt.TextColor3 = Theme.Text
					itemTxt.TextXAlignment = Enum.TextXAlignment.Left
					itemTxt.Parent = itemBtn

					itemBtn.MouseEnter:Connect(function()
						TweenService:Create(itemBtn, TweenInfo.new(0.1), { BackgroundTransparency = 0 }):Play()
					end)
					itemBtn.MouseLeave:Connect(function()
						TweenService:Create(itemBtn, TweenInfo.new(0.1), { BackgroundTransparency = 1 }):Play()
					end)

					itemBtn.MouseButton1Click:Connect(function()
						play()
						BtnTxt.Text = tostring(item)
						Popup.Visible = false
						callback(item)
					end)
				end

				local popupOpen = false
				local function closePopup()
					popupOpen = false
					local t = TweenService:Create(Popup, TweenInfo.new(0.12), {
						BackgroundTransparency = 1
					})
					t:Play()
					t.Completed:Connect(function()
						if not popupOpen then Popup.Visible = false end
					end)
				end

				Btn.MouseButton1Click:Connect(function()
					play()
					if popupOpen then closePopup(); return end
					popupOpen = true

					local abs = Btn.AbsolutePosition
					local size = Btn.AbsoluteSize
					local wAbs = Window.AbsolutePosition
					local s = UIScale.Scale
					local h = math.min(#items, 6) * 28 + 8

					Popup.Size = UDim2.new(0, size.X / s, 0, h)
					Popup.Position = UDim2.new(
						0, (abs.X - wAbs.X) / s,
						0, (abs.Y - wAbs.Y) / s + size.Y / s + 4
					)
					Popup.BackgroundTransparency = 1
					Popup.Visible = true
					TweenService:Create(Popup, TweenInfo.new(0.15), { BackgroundTransparency = 0 }):Play()
				end)

				UserInputService.InputBegan:Connect(function(input, gpe)
					if gpe or not popupOpen then return end
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						local m = UserInputService:GetMouseLocation()
						local pa = Popup.AbsolutePosition
						local ps = Popup.AbsoluteSize
						local inside = m.X >= pa.X and m.X <= pa.X + ps.X and m.Y >= pa.Y and m.Y <= pa.Y + ps.Y
						local overBtn = m.X >= Btn.AbsolutePosition.X and m.X <= Btn.AbsolutePosition.X + Btn.AbsoluteSize.X
							and m.Y >= Btn.AbsolutePosition.Y and m.Y <= Btn.AbsolutePosition.Y + Btn.AbsoluteSize.Y
						if not inside and not overBtn then closePopup() end
					end
				end)
			end

			return GroupObj
		end

		return TabObj
	end

	AstralisObj.Notify = function(self, opts) return notify(opts) end
	AstralisObj.Window = Window

	-- Keybind
	UserInputService.InputBegan:Connect(function(input, gpe)
		if gpe or UserInputService:GetFocusedTextBox() then return end
		if input.KeyCode == Theme.Keybind then
			visible = not visible
			setVisible(visible)
			if visible then tweenIn() else tweenOut() end
		end
	end)

	-- Reveal
	task.spawn(function()
		task.wait(0.05)
		setVisible(true)
		updateScale(false)
		UIScale.Scale = baseScale * 0.88
		TweenService:Create(Window, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			GroupTransparency = 0
		}):Play()
		TweenService:Create(UIScale, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Scale = baseScale
		}):Play()
		task.wait(0.1)
		if TabList[1] then switchTab(1) end
	end)

	return AstralisObj
end

return Astralis
