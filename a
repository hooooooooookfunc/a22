			floatingDrag = true
			floatingInput = input
			floatingStart = input.Position
			floatingPosition = FloatingBtn.Position
			floatingMoved = false
		end
	end)

	connect(UserInputService.InputChanged, function(input)
		if not floatingDrag then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input ~= floatingInput then
			return
		end

		local delta = input.Position - floatingStart

		if delta.Magnitude > 8 then
			floatingMoved = true
		end

		if floatingMoved then
			local viewport = ToggleGui.AbsoluteSize
			local originalX = floatingPosition.X.Scale * viewport.X + floatingPosition.X.Offset
			local originalY = floatingPosition.Y.Scale * viewport.Y + floatingPosition.Y.Offset

