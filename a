	Content.Parent = Window

	local ContentPad = Instance.new("UIPadding")
	ContentPad.PaddingTop = UDim.new(0, 12)
	ContentPad.PaddingBottom = UDim.new(0, 12)
	ContentPad.PaddingLeft = UDim.new(0, 12)
	ContentPad.PaddingRight = UDim.new(0, 12)
	ContentPad.Parent = Content

	local COL_GAP = 12
	local CurrentTab = nil

	local function makeTab()
		local Frame = Instance.new("Frame")
		Frame.Size = UDim2.new(1, 0, 1, 0)
		Frame.BackgroundTransparency = 1
		Frame.Visible = false
		Frame.Parent = Content

		local Col1 = Instance.new("Frame")
		Col1.Size = UDim2.new(0.5, -COL_GAP / 2, 1, 0)
		Col1.BackgroundTransparency = 1
		Col1.Parent = Frame

		local Col2 = Instance.new("Frame")
		Col2.Size = UDim2.new(0.5, -COL_GAP / 2, 1, 0)
		Col2.Position = UDim2.new(0.5, COL_GAP / 2, 0, 0)
		Col2.BackgroundTransparency = 1
		Col2.Parent = Frame

		local L1 = Instance.new("UIListLayout")
		L1.SortOrder = Enum.SortOrder.LayoutOrder
		L1.Padding = UDim.new(0, COL_GAP)
		L1.Parent = Col1

		local L2 = Instance.new("UIListLayout")
		L2.SortOrder = Enum.SortOrder.LayoutOrder
		L2.Padding = UDim.new(0, COL_GAP)
		L2.Parent = Col2

		return {
			Frame = Frame,
			Columns = { Col1, Col2 },
			Heights = { 0, 0 },
		}
	end

	-- Search filters by card attribute
	SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
		local q = string.lower(SearchBox.Text)
		if not CurrentTab then return end
		for _, col in ipairs(CurrentTab.Columns) do
			for _, card in ipairs(col:GetChildren()) do
				if card:IsA("Frame") and card:GetAttribute("SearchName") then
					local name = string.lower(card:GetAttribute("SearchName"))
					card.Visible = (q == "") or name:find(q, 1, true) ~= nil
				end
			end
		end
	end)

	-- ==========================================================
	-- Drag
	-- ==========================================================
	local dragging, dragStart, startPos = false, nil, nil
	Header.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = i.Position
			startPos = Window.Position
		end
	end)
	Header.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = (i.Position - dragStart) / UIScale.Scale
			Window.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + d.X,
				startPos.Y.Scale, startPos.Y.Offset + d.Y
			)
		end
	end)

	-- ==========================================================
	-- Window state
	-- ==========================================================
	local visible = true
	local minimized = false
	local maximized = false
	local restoreSize, restorePos = Window.Size, Window.Position

	local function setVisible(state)
		visible = state
		MainGui.Enabled = state
	end

	local function tweenIn()
		Window.GroupTransparency = 1
		UIScale.Scale = baseScale * 0.88
		TweenService:Create(Window, TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			GroupTransparency = 0
		}):Play()
		TweenService:Create(UIScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Scale = baseScale
		}):Play()
	end

	local function tweenOut()
		TweenService:Create(Window, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			GroupTransparency = 1
		}):Play()
		TweenService:Create(UIScale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Scale = baseScale * 0.9
		}):Play()
	end

	MinBtn.MouseButton1Click:Connect(function()
		play()
		minimized = not minimized
		if minimized then
			restoreSize = Window.Size
			Sidebar.Visible = false
			Content.Visible = false
			TweenService:Create(Window, TweenInfo.new(0.24, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				Size = UDim2.new(Window.Size.X.Scale, Window.Size.X.Offset, 0, HEADER_H)
			}):Play()
			MinBtn.Text = "+"
		else
			Sidebar.Visible = true
			Content.Visible = true
			TweenService:Create(Window, TweenInfo.new(0.24, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				Size = restoreSize
			}):Play()
			MinBtn.Text = "–"
		end
	end)

	MaxBtn.MouseButton1Click:Connect(function()
		play()
		maximized = not maximized
		if maximized then
			restoreSize, restorePos = Window.Size, Window.Position
			TweenService:Create(Window, TweenInfo.new(0.24, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				Size = UDim2.new(1, -40, 1, -40),
				Position = UDim2.new(0, 20, 0, 20),
				AnchorPoint = Vector2.new(0, 0)
			}):Play()
		else
			TweenService:Create(Window, TweenInfo.new(0.24, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				Size = restoreSize,
				Position = restorePos,
				AnchorPoint = Vector2.new(0.5, 0.5)
			}):Play()
		end
	end)

	CloseBtn.MouseButton1Click:Connect(function()
		play()
		setVisible(false)
		tweenOut()
		task.delay(0.25, function()
			if MainGui then MainGui:Destroy() end
		end)
	end)

	-- ==========================================================
	-- Notifications (original bottom-right style)
	-- ==========================================================
	local NotifyScreen = Instance.new("ScreenGui")
	NotifyScreen.Name = "AstralisNotify"
	NotifyScreen.ResetOnSpawn = false
	NotifyScreen.IgnoreGuiInset = true
	NotifyScreen.DisplayOrder = 200
	pcall(function() NotifyScreen.Parent = CoreGui end)
	if not NotifyScreen.Parent then NotifyScreen.Parent = LocalPlayer:WaitForChild("PlayerGui") end

	local NotifyHolder = Instance.new("Frame")
	NotifyHolder.Size = UDim2.new(0, 240, 0, 0)
	NotifyHolder.Position = UDim2.new(1, -20, 1, -20)
	NotifyHolder.AnchorPoint = Vector2.new(1, 1)
