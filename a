				EyeOverlay.Parent = EyeGui

				local crosshair = Instance.new("Frame")
				crosshair.Size = UDim2.new(0, 20, 0, 20)
				crosshair.AnchorPoint = Vector2.new(0.5, 0.5)
				crosshair.BackgroundTransparency = 1
				crosshair.ZIndex = 2
				crosshair.Parent = EyeGui

				local crosshairH = Instance.new("Frame")
				crosshairH.Size = UDim2.new(1, 0, 0, 1)
				crosshairH.Position = UDim2.new(0, 0, 0.5, 0)
				crosshairH.BackgroundColor3 = Color3.new(1, 1, 1)
				crosshairH.BorderSizePixel = 0
				crosshairH.ZIndex = 3
				crosshairH.Parent = crosshair

				local crosshairV = Instance.new("Frame")
				crosshairV.Size = UDim2.new(0, 1, 1, 0)
				crosshairV.Position = UDim2.new(0.5, 0, 0, 0)
				crosshairV.BackgroundColor3 = Color3.new(1, 1, 1)
				crosshairV.BorderSizePixel = 0
				crosshairV.ZIndex = 3
				crosshairV.Parent = crosshair

				local colorPreview = Instance.new("Frame")
				colorPreview.Size = UDim2.new(0, 40, 0, 40)
				colorPreview.Position = UDim2.new(0, 20, 0, 20)
				colorPreview.BackgroundColor3 = currentColor
				colorPreview.BorderSizePixel = 0
				colorPreview.ZIndex = 2
				colorPreview.Parent = EyeGui
				addCorner(colorPreview, 6)

				local previewStroke = Instance.new("UIStroke")
				previewStroke.Color = Color3.new(1, 1, 1)
				previewStroke.Thickness = 2
				previewStroke.Parent = colorPreview

				local hint = Instance.new("TextLabel")
				hint.Size = UDim2.new(0, 260, 0, 26)
				hint.Position = UDim2.new(0.5, -130, 1, -50)
				hint.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
				hint.BackgroundTransparency = 0.3
				hint.Text = "Click anywhere to sample  •  Right-click to cancel"
				hint.Font = Theme.Font
				hint.TextSize = 12
				hint.TextColor3 = Color3.new(1, 1, 1)
				hint.ZIndex = 3
				hint.Parent = EyeGui
				addCorner(hint, 4)

				UserInputService.InputChanged:Connect(function(input)
					if not eyedropperActive then return end
					if input.UserInputType == Enum.UserInputType.MouseMovement then
						crosshair.Position = UDim2.new(0, input.Position.X, 0, input.Position.Y)
						local ray = game.Workspace.CurrentCamera:ViewportPointToRay(input.Position.X, input.Position.Y)
						local params = RaycastParams.new()
						params.FilterType = Enum.RaycastFilterType.Exclude
						params.FilterDescendantsInstances = { LocalPlayer.Character }
						local result = game.Workspace:Raycast(ray.Origin, ray.Direction * 5000, params)
						if result and result.Instance then
							colorPreview.BackgroundColor3 = result.Instance.Color
						end
					end
				end)

				EyeOverlay.MouseButton1Click:Connect(function()
					local mouseLoc = UserInputService:GetMouseLocation()
					local ray = game.Workspace.CurrentCamera:ViewportPointToRay(mouseLoc.X, mouseLoc.Y)
					local params = RaycastParams.new()
					params.FilterType = Enum.RaycastFilterType.Exclude
					params.FilterDescendantsInstances = { LocalPlayer.Character }
					local result = game.Workspace:Raycast(ray.Origin, ray.Direction * 5000, params)
					if result and result.Instance then
						setColor(result.Instance.Color, currentAlpha, true)
					end
					stopEyedropper()
				end)

				EyeOverlay.MouseButton2Click:Connect(stopEyedropper)
			end)

			local dragging = false
			local dragStart, startPos

			Header.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					dragStart = input.Position
					startPos = Popup.Position
				end
			end)

			Header.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = false
				end
			end)

			UserInputService.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					local delta = input.Position - dragStart
					Popup.Position = UDim2.new(
						startPos.X.Scale, startPos.X.Offset + delta.X,
						startPos.Y.Scale, startPos.Y.Offset + delta.Y
					)
				end
			end)

			local OPEN_HEIGHT = baseY + 128

			local function setOpen(state)
				pickerOpen = state
				if state then
					local abs = Preview.AbsolutePosition
					local absSize = Preview.AbsoluteSize
					local vp = PopupGui.AbsoluteSize

					local popupW, popupH = 260, OPEN_HEIGHT
					local x = abs.X - popupW + absSize.X
					local y = abs.Y + absSize.Y + 6

					if x < 8 then x = 8 end
					if x + popupW > vp.X - 8 then x = vp.X - popupW - 8 end
					if y + popupH > vp.Y - 8 then y = abs.Y - popupH - 6 end
					if y < 8 then y = 8 end

					Popup.Position = UDim2.new(0, x, 0, y)
					Popup.Size = UDim2.new(0, popupW, 0, 0)
					PopupGui.Enabled = true

					TweenService:Create(Popup, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
						Size = UDim2.new(0, popupW, 0, popupH)
					}):Play()

					setColor(currentColor, currentAlpha, false)
				else
					local t = TweenService:Create(Popup, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
						Size = UDim2.new(0, 260, 0, 0)
					})
					t:Play()
					t.Completed:Connect(function()
						if not pickerOpen then
							PopupGui.Enabled = false
						end
					end)
				end
			end

			Preview.MouseButton1Click:Connect(function()
				playSound()
				setOpen(not pickerOpen)
			end)

			CloseX.MouseButton1Click:Connect(function()
				playSound()
				setOpen(false)
			end)

			setColor(currentColor, currentAlpha, false)

			return {
				Set = function(_, color, alpha)
					if typeof(color) == "Color3" then
						setColor(color, alpha, true)
					end
				end,
				Get = function() return currentColor end,
				GetAlpha = function() return currentAlpha end,
				Open = function() setOpen(true) end,
				Close = function() setOpen(false) end,
				PushRecent = function(_, color, alpha) pushRecent(color, alpha) end,
			}
		end

