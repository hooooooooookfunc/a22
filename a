					}):Play()
				end

				Btn.MouseButton1Click:Connect(function()
					play()
					if popupOpen then closePopup() else openPopup() end
				end)

				-- Close popup if user scrolls the sidebar/content
				UserInputService.InputBegan:Connect(function(input, gpe)
					if popupOpen and gpe then return end
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						if Popup.Visible then
							local mPos = UserInputService:GetMouseLocation()
							local popAbs = Popup.AbsolutePosition
							local popSize = Popup.AbsoluteSize
							local inside = mPos.X >= popAbs.X and mPos.X <= popAbs.X + popSize.X
								and mPos.Y >= popAbs.Y and mPos.Y <= popAbs.Y + popSize.Y
							local overBtn = mPos.X >= Btn.AbsolutePosition.X and mPos.X <= Btn.AbsolutePosition.X + Btn.AbsoluteSize.X
								and mPos.Y >= Btn.AbsolutePosition.Y and mPos.Y <= Btn.AbsolutePosition.Y + Btn.AbsoluteSize.Y
							if not inside and not overBtn then closePopup() end
						end
					end
				end)
			end

			function GroupObj:CreateInput(o)
				o = o or {}
				local name = o.Name or "Input"
				local default = o.Default or ""
				local placeholder = o.Placeholder or ""
				local callback = o.Callback or function() end

				local R = makeRow(66)

				local I = Instance.new("ImageLabel")
				I.Size = UDim2.new(0, 16, 0, 16)
				I.Position = UDim2.new(0, 0, 0, 4)
				I.BackgroundTransparency = 1
				I.Image = resolveIcon(o.Icon)
				I.ImageColor3 = Theme.TextMuted
				I.Parent = R

				local L = Instance.new("TextLabel")
				L.Size = UDim2.new(1, -26, 0, 18)
				L.Position = UDim2.new(0, 26, 0, 3)
				L.BackgroundTransparency = 1
				L.Text = name
				L.Font = Theme.Font
				L.TextSize = 13
				L.TextColor3 = Theme.Text
				L.TextXAlignment = Enum.TextXAlignment.Left
				L.Parent = R

				local Box = Instance.new("TextBox")
				Box.Size = UDim2.new(1, 0, 0, 30)
				Box.Position = UDim2.new(0, 0, 0, 28)
				Box.BackgroundColor3 = Theme.InputBg
				Box.BorderSizePixel = 0
				Box.Text = tostring(default)
				Box.PlaceholderText = placeholder
				Box.PlaceholderColor3 = Theme.TextMuted
				Box.Font = Theme.Font
				Box.TextSize = 12
				Box.TextColor3 = Theme.Text
				Box.TextXAlignment = Enum.TextXAlignment.Left
				Box.ClearTextOnFocus = false
				Box.Parent = R
				corner(Box, 8)
				local bstr = stroke(Box, Theme.Border, 1)

				local Pad = Instance.new("UIPadding")
				Pad.PaddingLeft = UDim.new(0, 10)
				Pad.PaddingRight = UDim.new(0, 10)
				Pad.Parent = Box

				Box.Focused:Connect(function()
					TweenService:Create(bstr, TweenInfo.new(0.15), { Color = Theme.Accent }):Play()
				end)
				Box.FocusLost:Connect(function()
					TweenService:Create(bstr, TweenInfo.new(0.15), { Color = Theme.Border }):Play()
					callback(Box.Text)
				end)
			end

			function GroupObj:CreateButton(o)
				o = o or {}
				local name = o.Name or "Button"
				local callback = o.Callback or function() end

				local R = makeRow(30)

				local I = Instance.new("ImageLabel")
				I.Size = UDim2.new(0, 16, 0, 16)
				I.Position = UDim2.new(0, 0, 0.5, -8)
				I.BackgroundTransparency = 1
				I.Image = resolveIcon(o.Icon)
				I.ImageColor3 = Theme.TextMuted
				I.Parent = R

				local Btn = Instance.new("TextButton")
				Btn.Size = UDim2.new(1, 0, 1, 0)
				Btn.BackgroundTransparency = 1
				Btn.Text = ""
				Btn.AutoButtonColor = false
				Btn.Parent = R
				noSelect(Btn)

				local L = Instance.new("TextLabel")
				L.Size = UDim2.new(1, -26, 1, 0)
				L.Position = UDim2.new(0, 26, 0, 0)
				L.BackgroundTransparency = 1
				L.Text = name
				L.Font = Theme.Font
				L.TextSize = 13
				L.TextColor3 = Theme.Text
				L.TextXAlignment = Enum.TextXAlignment.Left
				L.Parent = R

				Btn.MouseEnter:Connect(function()
					TweenService:Create(L, TweenInfo.new(0.12), { TextColor3 = Theme.Accent }):Play()
				end)
				Btn.MouseLeave:Connect(function()
					TweenService:Create(L, TweenInfo.new(0.12), { TextColor3 = Theme.Text }):Play()
				end)
				Btn.MouseButton1Click:Connect(function()
					play()
					callback()
				end)
			end

			function GroupObj:CreateLabel(o)
				o = o or {}
				local name = o.Name or "Label"
				local value = o.Value or ""
				local callback = o.Callback or function() end
				local rightColor = o.ValueColor or Theme.Text

				local R = makeRow(28)

				local I = Instance.new("ImageLabel")
				I.Size = UDim2.new(0, 14, 0, 14)
				I.Position = UDim2.new(0, 0, 0.5, -7)
				I.BackgroundTransparency = 1
				I.Image = resolveIcon(o.Icon)
				I.ImageColor3 = Theme.TextMuted
				I.Parent = R

				local L = Instance.new("TextLabel")
				L.Size = UDim2.new(1, -80, 1, 0)
				L.Position = UDim2.new(0, 24, 0, 0)
				L.BackgroundTransparency = 1
				L.Text = name
				L.Font = Theme.Font
				L.TextSize = 12
				L.TextColor3 = Theme.TextMuted
				L.TextXAlignment = Enum.TextXAlignment.Left
				L.Parent = R

				local V = Instance.new("TextLabel")
				V.Size = UDim2.new(0, 90, 1, 0)
				V.Position = UDim2.new(1, -90, 0, 0)
				V.BackgroundTransparency = 1
				V.Text = tostring(value)
				V.Font = Theme.Font
				V.TextSize = 12
				V.TextColor3 = rightColor
				V.TextXAlignment = Enum.TextXAlignment.Right
				V.Parent = R

				return {
					Set = function(_, v) V.Text = tostring(v) end,
					SetColor = function(_, c) V.TextColor3 = c end,
					Get = function() return V.Text end,
				}
			end

			function GroupObj:CreateDivider()
				local R = Instance.new("Frame")
				R.Size = UDim2.new(1, 0, 0, 1)
				R.BackgroundColor3 = Theme.Border
				R.BorderSizePixel = 0
				R.LayoutOrder = RowCount + 1
				R.Parent = Inner
				RowCount = RowCount + 1
				addHeight(1)
			end

			heightEstimate = heightEstimate + 6 -- gap after header
			tab.Heights[colIdx] = tab.Heights[colIdx] + 20 -- card padding + border

			return GroupObj
		end

		return TabObj
	end

	AthenaObj.Notify = function(self, opts) return notify(opts) end
	AthenaObj.Window = Window

	-- Keybind toggle
	UserInputService.InputBegan:Connect(function(input, gpe)
		if gpe then return end
		if UserInputService:GetFocusedTextBox() then return end
		if input.KeyCode == Theme.Keybind then
			visible = not visible
			setVisible(visible)
			if visible then tweenIn() else tweenOut() end
		end
	end)

	-- Initial reveal
	task.spawn(function()
		task.wait(0.05)
		setVisible(true)
		tweenIn()
	end)

	-- Init with first tab
	task.spawn(function()
		task.wait(0.1)
		if TabList[1] then switchTab(1) end
	end)

	return AthenaObj
end

return Athena
