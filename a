	-- Nav / Tab management
	-- ==========================================================
	local TabList = {}
	local ActiveIdx = 1

	local function switchTab(idx)
		if ActiveIdx == idx and TabList[idx] and TabList[idx].Tab.Frame.Visible then return end
		ActiveIdx = idx

		for i, entry in ipairs(TabList) do
			local active = (i == idx)
			local nav = entry.Nav
			local tab = entry.Tab

			if active then
				tab.Frame.Visible = true
				tab.Frame.GroupTransparency = 1
				TweenService:Create(tab.Frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
					GroupTransparency = 0
				}):Play()
				CurrentTab = tab
			else
				if tab.Frame.Visible then
					local t = TweenService:Create(tab.Frame, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
						GroupTransparency = 1
					})
					t:Play()
					t.Completed:Connect(function()
						if ActiveIdx ~= i then tab.Frame.Visible = false end
					end)
				end
			end

			TweenService:Create(nav.Bg, TweenInfo.new(0.15), {
				BackgroundTransparency = active and 0 or 1
			}):Play()
			TweenService:Create(nav.Icon, TweenInfo.new(0.15), {
				ImageColor3 = active and Theme.Accent or Theme.TextMuted
			}):Play()
			TweenService:Create(nav.Label, TweenInfo.new(0.15), {
				TextColor3 = active and Theme.Text or Theme.TextMuted
			}):Play()
		end
	end

